<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Property List View (Tree) -->
    <record id="view_property_tree" model="ir.ui.view">
        <field name="name">real_estate.property.tree</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <tree string="Properties" decoration-info="property_status == 'reserved'" decoration-danger="property_status == 'canceled'">
                <field name="name"/>
                <field name="price"/>
                <field name="bedrooms"/>
                <field name="description"/>
                <field name="available"/>
                <field name="create_date"/>
                <field name="create_uid"/>
                <field name="agent_id"/>
                <field name="property_type"/>
                <field name="property_status"/>
            </tree>
        </field>
    </record>
    <!-- Property Action (Links views together) -->
    <record id="action_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">real_estate.property</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first property
            </p>
        </field>
    </record>
    <record id="view_property_search" model="ir.ui.view">
        <field name="name">real_estate.property.search</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name"/>
                <field name="price"/>
                <field name="bedrooms"/>
                <separator/>
                <filter string="Active" name="active" domain="[('available', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('available', '=', False)]"/>
                <filter string="Villa" name="villa" domain="[('property_type', '=', 'villa')]"/>
                <filter string="Apartment" name="apartment" domain="[('property_type', '=', 'apartment')]"/>
                <filter string="House" name="house" domain="[('property_type', '=', 'house')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_by_type" context="{'group_by': 'property_type'}"/>
                    <filter string="Availability" name="group_by_availability" context="{'group_by': 'available'}"/>
                </group>
            </search>
        </field>
    </record>
**************************************
    <!-- Property Form View -->
    <record id="view_property_form" model="ir.ui.view">
        <field name="name">real_estate.property.form</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="mark_as_available" string="Mark as Available" type="object" invisible="property_status == 'available'" class="oe_highlight"/>
                    <button name="mark_as_occupied" string="Mark as Occupied" type="object" invisible="property_status in ('occupied','canceled','available','draft')" class="oe_highlight"/>
                    <button name="mark_as_reserved"  string="Mark as Reserved" type="object" invisible="property_status in ('reserved','draft') or property_status != 'available'" class="oe_highlight"/>
                    <button name="mark_as_canceled"  string="Mark as Canceled" type="object" invisible="property_status in ('canceled','draft') or property_status != 'occupied'" class="oe_highlight"/>
                    <button name="%(action_lease_wizard)d" string="Create Lease" type="action" context="{'default_property_id': active_id}" />
                    <field name="property_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" invisible ="lease_count == 0" >
                        <button name="action_view_leases"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o">
                            <field name="lease_count"
                                    widget="statinfo"
                                    string="Leases"/>
                        </button>
                        <button name="action_view_maintenances"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-wrench">
                            <field name="maintenance_count"
                                    widget="statinfo"
                                    string="Maintenance Requests"/>
                        </button>
                    </div>
                    <field name="property_image" 
                        widget="image" 
                        class="float-end" 
                        options="{'size': [250, 250]}" 
                        style="width: 250px !important; height: 250px !important; min-width: 250px; min-height: 250px;"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Property Name" />
                        </h1>
                    </div>
                    <group string="Property Details">
                        <group name="left_side">
                            <field name="property_type"/>
                            <field name="price" invisible="not available"/>
                            <field name="available" invisible="1"/>
                            <field name="deposite" string="Deposit Amount"/>
                            <field name="create_date" />
                            <field name="create_uid" />
                        </group>
                        <group name="right_side">
                            <field name="available" help="Indicates if the property is available for sale or rent"/>
                            <field name="agent_id"/>
                            <field name="discount"/>
                            <field name="bedrooms" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Add Your Description" widget="html"/>
                        </page>
                        <page string="Discount for Property" invisible="not available">
                            <field name="discount" placeholder="Add Your Discount" widget="html"/>
                        </page>
                        <field name="available" invisible="1"/>
                        <page string="Leases">
                            <field name="lease_ids">
                                <tree create="false" delete ="false">
                                    <field name="name"/>
                                    <field name="tenant_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                    <field name="activity_ids"/>
                </div>
            </form>
        </field>
    </record>
    <!-- Tenant Kanban View -->
    <record id="view_property_kanban" model="ir.ui.view">
        <field name="name">real_estate.property.kanban</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="price"/>
                <field name="property_type"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click p-0" style="overflow: hidden; border-radius: 8px;">
                            <div class="oe_kanban_details">
                                <div class="w-100" style="height: 140px; background-color: #f0f0f0;">
                                    <img t-att-src="kanban_image('real_estate.property', 'property_image', record.id.raw_value)" 
                                 alt="Property" 
                                 class="w-100 h-100" 
                                 style="object-fit: cover; border-radius: 4px;"/>
                                </div>
                                <div class="p-2">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="mt-1">
                                        <span class="form-label">Price </span>
                                        <field name="price"/>
                                    </div>
                                    <!-- <div class="mt-1">
                                    <field name="property_type" widget="selection"/>
                                </div> -->
                                    <div class="mt-1 d-flex justify-content-between">
                                        <div>
                                            <span class="form-label">Bedrooms </span>
                                            <field name="bedrooms"/>
                                        </div>
                                        <div>
                                            <field name="available"/>
                                        </div>
                                        <t t-if="record.property_type.raw_value == 'villa'">
                                            <span class="badge text-bg-success">Villa</span>
                                        </t>
                                        <t t-if="record.property_type.raw_value == 'apartment'">
                                            <span class="badge text-bg-info">Apartment</span>
                                        </t>
                                        <t t-if="record.property_type.raw_value == 'house'">
                                            <span class="badge text-bg-info">House</span>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>