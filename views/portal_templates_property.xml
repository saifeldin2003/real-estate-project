<?xml version="1.0" encoding="utf-8"?>
<odoo> 
<template id="portal_properties" name="Tenant Portal - My Target Properties">
    <t t-call="portal.portal_layout">

        <div class="container mt16 o_portal_portlets">

            <div class="row">
                <div class="col-12">
                    <nav class="breadcrumb" aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="/my/home">My Account</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                My Target Properties
                            </li>
                        </ol>
                    </nav>

                    <h1 class="mb16">My Target Properties</h1>
                </div>
            </div>

            <t t-if="properties">
                <div class="row">

                    <t t-foreach="properties" t-as="property">

                        <div class="col-md-6 mb16">
                            <div class="card h-100">
                                <div class="card-body">

                                    <h5 class="card-title mb-2">
                                        <t t-esc="property.name"/>
                                    </h5>

                                    <p class="text-muted mb-2">
                                        <strong>Description:</strong>
                                        <t t-esc="property.description"/>
                                    </p>

                                    <p class="mb-1">
                                        <strong>Property Type:</strong>
                                        <t t-esc="property.property_type or 'N/A'"/>
                                    </p>

                                    <p class="mb-1">
                                        <strong>Price:</strong>
                                        <t t-esc="property.price"/>
                                    </p>

                                    <p class="mb-1">
                                        <strong>Property Status:</strong>
                                        <t t-esc="property.property_status or 'N/A'"/>
                                    </p>

                                    <p class="mb-1">
                                        <strong>Deposite:</strong>
                                        <t t-esc="property.deposite"/>
                                    </p>

                                   
                                </div>
                            </div>
                        </div>

                    </t>

                </div>
            </t>

            <t t-if="not properties">
                <div class="row">
                    <div class="col-12">
                        <div class="alert alert-info" role="alert">
                            No target properties were found for your account.
                        </div>
                    </div>
                </div>
            </t>

        </div>

    </t>
</template>

    <template id="portal_properties_menu" name="Portal My Home: My Target Properties" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_service_category" position="inside">
            <t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'fa fa-home'"/> 
                    <t t-set="title">My Target Properties</t>
                    <t t-set="text">View your target properties.</t>
                    <t t-set="url" t-value="'/my/properties'"/>
                    <t t-set="config_card" t-value="True"/>
                    <t t-set="placeholder_count" t-value="'property_count'"/>
                </t>
            </t>
        </div>
    </template>
    </odoo>