<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lease List View (Tree) -->
    <record id="view_payment_tree" model="ir.ui.view">
        <field name="name">lease.payment.tree</field>
        <field name="model">lease.payment</field>
        <field name="arch" type="xml">

            <tree string="Payments">
               <field name="name"/>
                <field name="lease_id"/>
                <field name="tenant_id"/>
                <field name="amount"/>
                <field name="late_fee"/>
                <field name="late_fee_applied"/>
                <field name="property_id"/>
                
                <field name="payment_date"/>
                <field name="payment_method"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-danger="state == 'draft'" decoration-warning="state == 'reconciled'" />
            </tree>
        </field>
    </record>

    <!-- Lease Action (Links views together) -->
    <record id="action_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">lease.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Payment
            </p>
        </field>
    </record>

      <record id="ir_cron_auto_paid_payments" model="ir.cron">
        <field name="name">Real Estate: Auto Paid Payments</field>
        <field name="model_id" ref="model_lease_payment"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_paid_payments()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
        <field name="nextcall">2026-09-22 13:10:00</field>
    </record>



    <!-- Lease Form View -->
    <record id="view_payment_form" model="ir.ui.view">
        <field name="name">lease.payment.form</field>
        <field name="model">lease.payment</field>
        <field name="arch" type="xml">
            <form string="Payment">
            <header>
                <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <!-- <div class="oe_button_box" name="button_box">
                        <button name="action_view_tenant" type="object" string="Tenant" class="oe_stat_button" icon="fa-user">
                        </button>

                    </div> -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Payment Name"/>
                        </h1>
                    </div>
                    
                        <group string="Payments Details">
                            <field name="lease_id"/>
                            <field name="tenant_id"/>
                            <field name="amount"/>
                            <field name="late_fee"/>
                            <field name="late_fee_applied"/>
                            <field name="property_id"/>
                            
                            <field name="payment_date"/>
                            <field name="due_date"/>
                            <field name="payment_method"/>
                        </group>
                       
                       



                    <notebook>
                        <page string="Leases">
                            

                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>



