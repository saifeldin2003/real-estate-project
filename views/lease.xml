<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lease List View (Tree) -->
    <record id="view_lease_tree" model="ir.ui.view">
        <field name="name">real_estate.lease.tree</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">

            <tree string="Leases">
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-danger="state == 'cancelled'" decoration-warning="state == 'expired'" />
                <field name="start_date"/>
                <field name="end_date"/>

            </tree>
        </field>
    </record>

    <!-- Lease Action (Links views together) -->
    <record id="action_lease" model="ir.actions.act_window">
        <field name="name">Leases</field>
        <field name="res_model">real_estate.lease</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first lease
            </p>
        </field>
    </record>

     <record id="ir_cron_auto_expire_leases" model="ir.cron">
        <field name="name">Real Estate: Auto Expire Leases</field>
        <field name="model_id" ref="model_real_estate_lease"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_expire_leases()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>



    <!-- Lease Form View -->
    <record id="view_lease_form" model="ir.ui.view">
        <field name="name">real_estate.lease.form</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <form string="Lease">
                <header>
                    <button name="convert_to_activate" string="Convert to Activate" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_submit_request_electricity" string="Submit Electricity Request" type="object" class="oe_highlight" />
                    <button name="convert_to_draft" string="Convert to Draft" type="object" class="oe_highlight" invisible="state != 'active'"/>
                    <button name="%(real_estate.action_maintenance_request_wizard)d" string="Maintenance Request" type="action" context="{'default_lease_id': active_id}" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,at_risk,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tenant" type="object" string="Tenant" class="oe_stat_button" icon="fa-user">
                        </button>

                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Lease Name"/>
                        </h1>
                    </div>
                    <group >
                        <group string="Lease Details">
                            <field name="monthly_rent"/>
                            <field name="deposit_paid"/>
                            <field name="duration"/>
                            <field name="is_active"/>
                            <field name="property_id" domain="[('available', '=', True)]"/>
                            <field name="tenant_id"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Lease Dates">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="next_electric_recharge_date"/>
                            <field name="duration"/>
                        </group>
                    </group>

                    <group string="Types of Maintenance Costs">
                        <group >
                            <field name="maintenance_plumbing_costs"/>
                            <field name="maintenance_electrical_costs"/>
                            <field name="maintenance_air_condition_costs"/>
                        </group>
                        <group >
                            <field name="maintenance_appliance_costs"/>
                            <field name="maintenance_other_costs"/>
                            <field name="maintenance_actual_costs"/>
                        </group>

                    </group>






                    <notebook>
                        <page string="Maintanance Requsets">
                            <field name="maintenance_ids">
                                <tree create="true" delete ="false">
                                    <field name="name"></field>
                                    <field name="lease_id"></field>
                                    <field name="tenant_id"></field>
                                    <field name="property_id"></field>
                                    <field name="issue_type"></field>
                                    <field name="actual_cost"></field>
                                </tree>
                            </field>

                        </page>
                        <page string="Payments Details">
                            
                                <group >
                                    <group >
                                        <field name="cash_details"/>
                                        <field name="check_details"/>
                                        <field name="bank_transfer_details"/>
                                    </group>
                                    <group >
                                        <field name="credit_card_details"/>
                                        <field name="other_details"/>
                                    </group>
                                </group>
                            
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>



    <record id="view_lease_search" model="ir.ui.view">
        <field name="name">real_estate.lease.search</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <search string="Search Leases">
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="monthly_rent"/>

                <separator/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="At Risk" name="at_risk" domain="[('state', '=', 'at_risk')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>

                <separator/>
                <group string="Group By">
                    <filter string="Status" name="group_by_status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Lease Kanban View -->
    <record id="view_lease_kanban" model="ir.ui.view">
        <field name="name">real_estate.lease.kanban</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-1">
                                    <field name="property_id"/>
                                </div>
                                <div class="mt-1">
                                    <field name="tenant_id"/>
                                </div>
                                <div class="text-muted mt-1">
                                    Start Date: <field name="start_date"/>
                                </div>
                                <div class="text-muted mt-1">
                                    End Date: <field name="end_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


</odoo>