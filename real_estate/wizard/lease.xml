<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard View -->
    <record id="view_lease_request_wizard_form" model="ir.ui.view">
        <field name="name">lease.wizard.form</field>
        <field name="model">real.estate.lease.wizard</field>
        <field name="arch" type="xml">
            <form string="Maintenance Request">
                <group>
                    <group>
                        <field name="tenant_id" />
                        <field name="property_id" />
                    </group>
                    <group>
                        <field name="user_id"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="monthly_rent"/>
                    </group>
                    <group>
                        <field name="deposit_paid"/>
                    </group>
                    <group>
                        <field name="state"/>
                    </group>
                </group>
               
                <footer>
                    <button name="action_submit_request" string="Submit Request" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_lease_wizard" model="ir.actions.act_window">
        <field name="name">Lease</field>
        <field name="res_model">real.estate.lease.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

