<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tenant List View (Tree) -->
    <record id="view_tenant_tree" model="ir.ui.view">
        <field name="name">real_estate.tenant.tree</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
        
            <tree string="Tenants" default_order="create_date asc">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="city"/>
                <field name="tenant_status" widget="badge" 
                decoration-success="tenant_status == 'active'"
                decoration-danger="tenant_status == 'cancelled'"
                decoration-warning="tenant_status == 'expired'"
                />
                <!-- <field name="crm_lead_id"/> -->
                
            </tree>
        </field>
    </record>

    <!-- Tenant Action (Links views together) -->
    <record id="action_tenant" model="ir.actions.act_window">
        <field name="name">Tenants</field>
        <field name="res_model">real_estate.tenant</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first tenant
            </p>
        </field>
    </record>

 <record id="view_tenant_search" model="ir.ui.view">
        <field name="name">real_estate.tenant.search</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <search string="Search Tenants">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Age Category" name="group_by_age_category" context="{'group_by': 'age_category'}"/>
                </group>
            </search>
        </field>
    </record>

     
 <!-- Tenant Form View -->
    <record id="view_tenant_form" model="ir.ui.view">
        <field name="name">real_estate.tenant.form</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <form string="Tenant">
            <header>
                     <button name="set_name_notes" groups="real_estate.group_tenant_manager" string="Set Name and Notes" type="object" class="oe_highlight"/>
                     <button name="get_lead_name" groups="real_estate.group_tenant" string="Get Lead Name" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                <div class="oe_button_box" name="button_box" invisible ="lease_count == 0">
                        <button name="action_view_leases"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o">
                            <field name="lease_count"
                                    widget="statinfo"
                                    string="Leases"/>
                        </button>
                        <button name="action_view_maintenance"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-wrench">
                            <field name="maintenance_count"
                                    widget="statinfo"
                                    string="Maintenance Requests"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tenant Name"/>
                        </h1>
                    </div>

                   <group string="Tenant Details">
                    <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="city"/>
                        </group>
                       
                        <group>
                            <field name="crm_lead_id" readonly="true"/>
                            <field name="date_of_birth" />
                            <field name="active" />
                             <field name="user_id"/>
                        </group>
                        
                    </group>
                    <group>
                        <group>
                            <field name="date_joined" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Internal Notes" name="internal_notes">
                                <field name="notes" placeholder="Add a description..." widget="html" options="{'collaborative': true}"/>
                            </page>
                             <page string="Leases">
                            <field name="lease_ids">
                                <tree create="false" delete ="false">
                                    <field name="name"/>
                                    <field name="tenant_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>

                                </tree>
                                </field>

                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="message_ids"/>
                <field name="activity_ids"/>
                </div>
            </form>
        </field>
    </record>


     <!-- Tenant Kanban View -->
    <record id="view_tenant_kanban" model="ir.ui.view">
        <field name="name">real_estate.tenant.kanban</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="email"/>
                <field name="date_joined"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-1">
                                    <field name="email" widget="email"/>
                                </div>
                                <div class="text-muted mt-1">
                                    Joined: <field name="date_joined"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>