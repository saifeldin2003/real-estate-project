<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lease List View (Tree) -->
    <record id="view_lease_tree" model="ir.ui.view">
        <field name="name">real_estate.lease.tree</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
        
            <tree string="Leases">
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                
            </tree>
        </field>
    </record>

    <!-- Lease Action (Links views together) -->
    <record id="action_lease" model="ir.actions.act_window">
        <field name="name">Leases</field>
        <field name="res_model">real_estate.lease</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first lease
            </p>
        </field>
    </record>


     
 <!-- Lease Form View -->
    <record id="view_lease_form" model="ir.ui.view">
        <field name="name">real_estate.lease.form</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <form string="Lease">
          <header>
          <button name="convert_to_activate" string="Convert to Activate" type="object" class="oe_highlight" invisible="state != 'draft'"/>
          <button name="convert_to_draft" string="Convert to Draft" type="object" class="oe_highlight" invisible="state != 'active'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,active,at_risk,expired,cancelled"/>
          </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Lease Name"/>
                        </h1>
                    </div>

                   <group string="Lease Details">
                    <group>
                            <field name="monthly_rent"/>
                        </group>
                        <group>
                            <field name="deposit_paid"/>
                        </group>
                        <group>
                            <field name="property_id"/>
                        </group>
                        <group>
                            <field name="tenant_id"/>
                        </group>
                        
                    <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                    </group>
                   
                    <!-- <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook> -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>



 <record id="view_lease_search" model="ir.ui.view">
        <field name="name">real_estate.lease.search</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <search string="Search Leases">
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="monthly_rent"/>

                <separator/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="At Risk" name="at_risk" domain="[('state', '=', 'at_risk')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>

                <separator/>
                <group string="Group By">
                    <filter string="Status" name="group_by_status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    
     <!-- Lease Kanban View -->
    <record id="view_lease_kanban" model="ir.ui.view">
        <field name="name">real_estate.lease.kanban</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-1">
                                    <field name="property_id"/>
                                </div>
                                <div class="mt-1">
                                    <field name="tenant_id"/>
                                </div>
                                <div class="text-muted mt-1">
                                    Start Date: <field name="start_date"/>
                                </div>
                                <div class="text-muted mt-1">
                                    End Date: <field name="end_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

     
</odoo>