<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Maintenance Request List View (Tree) -->
    <record id="view_maintenance_request_tree" model="ir.ui.view">
        <field name="name">real_estate.maintenance_request.tree</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <tree string="Maintenance Requests">
               <field name="name"></field>
               <field name="lease_id"></field>
               <field name="tenant_id"></field>
               <field name="property_id"></field>
               <field name="issue_type"></field>
               <field name="assigned_to"></field>
            </tree>
        </field>
    </record>


