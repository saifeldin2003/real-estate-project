<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard View -->
    <record id="view_tenant_request_wizard_form" model="ir.ui.view">
        <field name="name">tenant.wizard.form</field>
        <field name="model">real.estate.tenant.wizard</field>
        <field name="arch" type="xml">
            <form string="Maintenance Request">
               <group name="Tenant Details">
                 <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="mobile"/>
               </group>
                
               
                <footer>
                    <button name="action_submit_request" string="Submit Request" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tenant_wizard" model="ir.actions.act_window">
        <field name="name">Tenant</field>
        <field name="res_model">real.estate.tenant.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

